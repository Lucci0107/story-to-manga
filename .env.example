# アプリケーション設定
APP_ENV=development
STORY_MANGA_DATA_DIR=./data
# 未指定時は上記data_dir内のSQLite。将来はpostgresql://...を指定可能。
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT_SECONDS=10
# 現在はlocalのみ。S3互換実装追加時にbackendを切り替える。
STORAGE_BACKEND=local
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
MAX_UPLOAD_BYTES=5242880
SESSION_DAYS=14

# 管理者bootstrap。両方を設定した場合のみ初回管理者を作成します。
# 既存管理者や既存ユーザーのパスワードは上書きしません。
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# AI設定。AI_PROVIDER/IMAGE_PROVIDERをopenaiへ変更すると実AIを使用します。
# 未設定の場合は課金のない決定論的なデモプロバイダを使用します。
AI_PROVIDER=openai
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
OPENAI_MODELS_URL=https://api.openai.com/v1/models
OPENAI_IMAGE_URL=https://api.openai.com/v1/images/generations
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=1
OPENAI_MAX_OUTPUT_TOKENS=12000

# OPENAI_MODELは旧設定との互換用です。互換エンドポイントを使う場合は
# OPENAI_RESPONSES_URLへResponses APIのURLを指定してください。

# Render等で起動するポート。ローカルでは未指定でも構いません。
PORT=8000
